## Cell downsampling

```{R}
idx <- split(seq(ncol(sce)), sce$celltype_level2)
names(idx)
```

```{R}
set.seed(123)
n_cells <- 100
cs_keep <- lapply(idx, function(i) {
  n <- length(i)
  if (n < n_cells) {
    sample(i, n)
  } else {
    sample(i, n_cells)
  }
})

sce <- sce[, unlist(cs_keep)]
```
# Cell-Type Deconvolution with SPOTlight

```{R}
-Type Deconvolution with SPOTlight
# Create output folder
output_dir <- "Exercise6_results"
dir.create(output_dir, showWarnings = FALSE)

# Function to run SPOTlight on one SPE
run_spotlight <- function(spe, sample_name) {

  # Keep original SPE unchanged during gene renaming
  spe_spotlight <- spe

  # Use unique gene symbols to match LungMAP
  rownames(spe_spotlight) <-
    scuttle::uniquifyFeatureNames(
      ID = rowData(spe)$ID,
      names = rowData(spe)$Symbol
    )

  # Check raw counts and gene overlap
  stopifnot("counts" %in% assayNames(spe_spotlight))

  shared_genes <- intersect(
    rownames(spe_spotlight),
    rownames(sce)
  )

  cat(sample_name, "- Shared genes:",
      length(shared_genes), "\n")

  stopifnot(length(shared_genes) > 1000)

  # Run deconvolution
  set.seed(123)

  deconv <- SPOTlight::SPOTlight(
    x = sce,
    y = spe_spotlight,
    groups = as.character(sce$celltype_level2),
    mgs = mgs_df,
    hvg = hvg,
    weight_id = "mean.AUC",
    group_id = "cluster",
    gene_id = "gene"
  )

  # Extract cell-type contributions
  mat <- deconv$mat

  # Match spot order
  stopifnot(all(colnames(spe) %in% rownames(mat)))
  mat <- mat[colnames(spe), , drop = FALSE]

  # Check T-cell predictions
  stopifnot(all(
    c("CD4 T", "CD8 T") %in% colnames(mat)
  ))

  stopifnot(all(is.finite(
    mat[, c("CD4 T", "CD8 T"), drop = FALSE]
  )))

  # Add T-cell contributions to original SPE
  spe$spotlight_CD4T <- mat[, "CD4 T"]
  spe$spotlight_CD8T <- mat[, "CD8 T"]

  # Save all cell-type estimates
  saveRDS(
    mat,
    file.path(
      output_dir,
      paste0(sample_name, "_SPOTlight.rds")
    )
  )

  return(spe)
}

```

```{R}
# Day 0 Young
spe_y0 <- run_spotlight(
  spe_y0, "Day0_Young"
)

# Day 9 Young
spe_y9 <- run_spotlight(
