```{r}
# Select variables for comparison
comparison_variables <- c(
  "spotlight_CD4T",
  "spotlight_CD8T",
  "tcell_naive_like",
  "tcell_effector_like",
  "tcell_memory_like",
  "interferon_gamma_response",
  "interferon_alpha_response",
  "inflammatory_response"
)

# Calculate sample-level summaries
comparison <- do.call(rbind, lapply(
  names(spe_list), function(nm) {

    spe <- spe_list[[nm]]

    stopifnot(all(
      comparison_variables %in%
        colnames(colData(spe))
    ))

    medians <- vapply(
      comparison_variables,
      function(sig) {
        median(spe[[sig]], na.rm = TRUE)
      },
      numeric(1)
    )

    data.frame(
      sample = nm,
      as.list(medians),
      check.names = FALSE
    )
  }
))

print(comparison)

write.csv(
  comparison,
  file.path(
    output_dir,
    "Four_sample_comparison.csv"
  ),
  row.names = FALSE
)
