# Generate four-sample spatial maps
for (sig in selected_signatures) {

  # Check signature exists in every sample
  stopifnot(all(vapply(
    spe_list,
    function(s) sig %in% colnames(colData(s)),
    logical(1)
  )))

  # Common colour scale across four samples
  max_value <- max(vapply(
    spe_list,
    function(s) max(s[[sig]], na.rm = TRUE),
    numeric(1)
  ))

  plots <- lapply(names(spe_list), function(nm) {

    ggspavis::plotSpots(
      spe_list[[nm]],
      annotate = sig,
      point_size = 0.7
    ) +
      scale_colour_gradient(
        low = "grey95",
        high = "darkred",
        limits = c(0, max_value)
      ) +
      ggtitle(nm)
  })

  combined <- patchwork::wrap_plots(
    plots,
    ncol = 2
  )

  print(combined)

  # Save figure
  ggsave(
    file.path(
      output_dir,
      "figures",
      paste0(sig, "_four_samples.pdf")
    ),
    plot = combined,
    width = 12,
    height = 9
  )
}
