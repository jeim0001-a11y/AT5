```{r}
library(DESpace)

# Run DESpace for all four datasets
res_DESpace <- lapply(names(spe_list), function(nm) {

  spe <- spe_list[[nm]]

  # Check spatial clustering exists
  stopifnot(
    "Leiden_Banksy" %in% colnames(colData(spe))
  )

  set.seed(123)

  res <- DESpace::DESpace_test(
    spe,
    spatial_cluster = "Leiden_Banksy",
    verbose = TRUE
  )

  # Extract gene results
  results <- as.data.frame(res$gene_results)

  # Sort by FDR
  results <- results[
    order(results$FDR, na.last = TRUE),
    ,
    drop = FALSE
  ]

  # Save results
  write.csv(
    results,
    file.path(
      output_dir,
      paste0(nm, "_DESpace.csv")
    ),
    row.names = FALSE
  )

  cat(
    nm, "- Significant DESpace SVGs:",
    sum(results$FDR < 0.05, na.rm = TRUE),
    "\n"
  )

  return(results)
})

names(res_DESpace) <- names(spe_list)

# Check top genes for every sample
lapply(res_DESpace, head)
