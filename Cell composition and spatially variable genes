## Perform cell type annotation with singleR

'''{R}
ref <- celldex::MouseRNAseqData()
spe_y0_sym <- spe_y0
spe_y9_sym <- spe_y9
spe_a0_sym <- spe_a0
spe_a9_sym <- spe_a9
'''

## Predict cell type for each spot

### y0
'''{R}
pred_y0 <- SingleR(
test = spe_y0_sym,
ref = ref,
labels = ref$label.main,
assay.type.test = "logcounts",
assay.type.ref = "logcounts"
)
'''

