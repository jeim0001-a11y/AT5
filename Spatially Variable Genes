```{r}
library(msigdbr)
library(AUCell)
library(Matrix)

# Find genes present in all four samples
id_lists <- lapply(spe_list, function(s) {

  ids <- as.character(rowData(s)$ID)

  # Exclude missing and duplicated identifiers
  ids[
    !is.na(ids) &
    nzchar(ids) &
    !duplicated(ids) &
    !duplicated(ids, fromLast = TRUE)
  ]
})

common_ids <- Reduce(intersect, id_lists)

cat("Shared genes:", length(common_ids), "\n")

stopifnot(length(common_ids) > 1000)

# Retrieve mouse Hallmark gene sets
db <- msigdbr::msigdbr(
  species = "Mus musculus",
  collection = "H"
)

gs <- split(db$ensembl_gene, db$gs_name)

names(gs) <- tolower(
  gsub("HALLMARK_", "", names(gs))
)

# Keep genes present in the common gene universe
gs <- lapply(gs, function(x) {
  intersect(unique(x), common_ids)
})

# Require at least 5 detected genes per signature
gs <- gs[lengths(gs) >= 5]

cat("Hallmark signatures:", length(gs), "\n")
