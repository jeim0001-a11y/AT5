##  Load cell-type reference data from the LungMAP project

```{R}
ref_path <- "/fs04/scratch2/bm26/shared_spatial_scRNAseq_env/reference/LungMAP_MouseLung_CellRef.v1.ref <- readH5AD(ref_path, reader = "R", use_hdf5 = TRUE)
ref_data <- h5read(ref_path, "raw/X/data")
ref_indices <- h5read(ref_path, "raw/X/indices")
ref_indptr <- h5read(ref_path, "raw/X/indptr")
raw_counts <- new("dgCMatrix",
              x = as.numeric(ref_data),
              i = as.integer(ref_indices),
              p = as.integer(ref_indptr),
              Dim = c(26727L, 71439L),
              Dimnames = list(rownames(ref), colnames(ref)))
print(head(Matrix::colSums(raw_counts), 10))
```

```{R}
stopifnot(
  identical(dim(raw_counts), dim(ref)),
  isTRUE(all.equal(
    as.numeric(Matrix::colSums(raw_counts)[1:10]),
    as.numeric(ref$nCount_RNA[1:10])
  ))
)
```

