     xlab = "Mean expression (log-counts)",
     ylab = "Total variance (log-counts)",
     main = "Mean-Variance Trend"
)
curve(metadata(dec)$trend(x), add = TRUE, col = "dodgerblue", lwd = 2)

#---Step 6: Visualize the HVGs---#\

