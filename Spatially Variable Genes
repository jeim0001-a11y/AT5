## Run nnSVG

```{R}
set.seed(123)

svg_list <- lapply(sub_list, function(sub) {
  nnSVG::nnSVG(sub)
})

# Extract results for each sample
res_nnSVG <- lapply(svg_list, function(sub) {

  results <- as.data.frame(rowData(sub))

  results <- results[
    order(results$padj, na.last = TRUE),
  ]

  return(results)
})

# View the top SVGs for each sample
lapply(res_nnSVG, head)
```

