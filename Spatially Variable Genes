```{r}
# Use the same ranking threshold for all samples
auc_max_rank <- ceiling(0.05 * length(common_ids))

# Run AUCell for all four datasets
spe_list <- lapply(names(spe_list), function(nm) {

  spe <- spe_list[[nm]]

  cat("Running AUCell for:", nm, "\n")

  # Match the common Ensembl IDs
  idx <- match(
    common_ids,
    as.character(rowData(spe)$ID)
  )

  stopifnot(!anyNA(idx))

  # Extract expression matrix
  mtx <- as(
    logcounts(spe)[idx, , drop = FALSE],
    "dgCMatrix"
  )

  rownames(mtx) <- common_ids

  # Build expression rankings
  set.seed(123)

  rnk <- AUCell::AUCell_buildRankings(
    mtx,
    plotStats = FALSE,
    verbose = FALSE
  )

  # Calculate pathway and T-cell signature scores
  auc <- AUCell::AUCell_calcAUC(
    geneSets = all_gene_sets,
    rankings = rnk,
    aucMaxRank = auc_max_rank,
    verbose = FALSE
  )

  # Transpose: spots x signatures
  scores <- t(as.matrix(assay(auc)))

  # Match spot order
  stopifnot(
    all(colnames(spe) %in% rownames(scores))
  )

  scores <- scores[
    colnames(spe),
    ,
    drop = FALSE
  ]

  # Add scores to SPE metadata
  for (sig in colnames(scores)) {
    spe[[sig]] <- scores[, sig]
  }

  # Save complete score matrix
  write.csv(
    scores,
    file.path(
      output_dir,
      paste0(nm, "_AUCell.csv")
    )
  )

  return(spe)
})

names(spe_list) <- c(
  "Day0_Young",
  "Day9_Young",
  "Day0_Aged",
  "Day9_Aged"
)

# Check calculated signatures
colnames(colData(spe_list$Day0_Young))
