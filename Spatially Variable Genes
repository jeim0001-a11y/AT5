    "Slamf6", "Cd27", "Cxcr3", "Bach2"
  )
)

# Use Day 0 Young gene annotations to map
# gene symbols to Ensembl IDs
annotation <- rowData(spe_list$Day0_Young)

tcell_sets <- lapply(tcell_markers, function(markers) {

  ids <- as.character(annotation$ID[
    as.character(annotation$Symbol) %in% markers
  ])

  intersect(unique(ids), common_ids)
})

# Check how many genes are available
print(lengths(tcell_sets))

# Require reasonable gene-set coverage
if (any(lengths(tcell_sets) < 5)) {
  stop("Insufficient T-cell marker overlap. Review signatures.")
}

# Combine Hallmark and T-cell gene sets
all_gene_sets <- c(gs, tcell_sets)
