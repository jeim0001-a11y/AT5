print(head(ref$nCount_RNA, 10))
```

## Convert the reference single-cell data into a Seurat object

```{R}
sce <- CreateSeuratObject(counts = raw_counts,
                          meta.data = as.data.frame(colData(ref)))
```

## Filter LungMAP reference data


```{R}
table(sce$Time,sce$celltype_level2)
```

```{R}
sce <- sce[, sce$Time == "PND28"]
table(sce$Time,sce$celltype_level2)
```

## Feature selection

```{R}
sce <- as.SingleCellExperiment(sce, assay = "RNA")
```

```{R}
sce <- logNormCounts(sce)
```

### Model variance
```{R}
genes <- !grepl(pattern = "^Rp[l|s]|Mt", x = rownames(sce))
dec <- modelGeneVar(sce, subset.row = genes)
plot(dec$mean, dec$total, xlab = "Mean log-expression", ylab = "Variance")
curve(metadata(dec)$trend(x), col = "blue", add = TRUE)
```

### Get 3000 most HVG
```{R}
hvg <- getTopHVGs(dec, n = 3000)
```

```{R}
colLabels(sce) <- colData(sce)$celltype_level2
mgs <- scran::scoreMarkers(sce, subset.row = genes)
```

```{R}
check_mgs <- as.data.frame(mgs[["AT2"]])
head(check_mgs)
```

```{R}
mgs_fil <- lapply(names(mgs), function(i) {
  x <- mgs[[i]]
  # Filter and keep relevant marker genes, those with AUC > 0.8
  x <- x[x$mean.AUC > 0.8, ]
  # Sort the genes from highest to lowest weight
  x <- x[order(x$mean.AUC, decreasing = TRUE), ]
  # Add gene and cluster id to the dataframe
  x$gene <- rownames(x)
  x$cluster <- i
  data.frame(x)
})
mgs_df <- do.call(rbind, mgs_fil)
```

```{R}
table(mgs_df$cluster)

stopifnot(
  all(c("CD4 T", "CD8 T") %in% mgs_df$cluster)
)
```

## Cell downsampling

```{R}
idx <- split(seq(ncol(sce)), sce$celltype_level2)
names(idx)
```

```{R}
set.seed(123)
n_cells <- 100
cs_keep <- lapply(idx, function(i) {
  n <- length(i)
  if (n < n_cells) {
    sample(i, n)
  } else {
    sample(i, n_cells)
  }
})

sce <- sce[, unlist(cs_keep)]
```
# Cell-Type Deconvolution with SPOTlight

### y0
```{R}
deconv_y0 <- SPOTlight(
  x = sce,
  y = spe_y0,
  groups = as.character(sce$celltype_level2),
  mgs = mgs_df,
  hvg = hvg,
  weight_id = "mean.AUC",
  group_id = "cluster",
  gene_id = "gene")
```

```{R}
head(mat_y0 <- deconv_y0$mat)[, seq_len(3)]
```

```{R}
mod_y0 <- deconv_y0$NMF
```

```{R}
plotCorrelationMatrix(mat_y0)
```

```{R}
ct_y0 <- colnames(mat_y0)
mat_y0[mat_y0 < 0.1] <- 0
# Define color palette
# (here we use 'paletteMartin' from the 'colorBlindness' package)
paletteMartin <- c(
  "#000000", "#004949", "#009292", "#ff6db6", "#ffb6db",
  "#490092", "#006ddb", "#b66dff", "#6db6ff", "#b6dbff",
  "#920000", "#924900", "#db6d00", "#24ff24", "#ffff6d")

pal_y0 <- colorRampPalette(paletteMartin)(length(ct_y0))
names(pal_y0) <- ct_y0

plotSpatialScatterpie(
  x = spe_y0,
  y = mat_y0,
  cell_types = colnames(mat_y0),
  img = FALSE,
  scatterpie_alpha = 1,
  pie_scale = 0.4) +
  scale_fill_manual(
    values = pal_y0,
    breaks = names(pal_y0))
```
