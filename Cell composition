```{R}
# Generate comparable spatial maps
for (cell in c("spotlight_CD4T",
               "spotlight_CD8T")) {

  # Same colour scale across four samples
  max_value <- max(vapply(
    spe_list,
    function(s) max(s[[cell]], na.rm = TRUE),
    numeric(1)
  ))

  stopifnot(is.finite(max_value), max_value > 0)

  plots <- lapply(names(spe_list), function(nm) {

    ggspavis::plotSpots(
      spe_list[[nm]],
      annotate = cell,
      point_size = 0.7
    ) +
      scale_colour_gradient(
        low = "grey95",
        high = "darkred",
        limits = c(0, max_value)
      ) +
      ggtitle(nm)
  })

  combined_plot <- patchwork::wrap_plots(
    plots,
    ncol = 2
  )

  print(combined_plot)

  ggsave(
    file.path(
      output_dir,
      paste0(cell, "_four_samples.pdf")
    ),
    plot = combined_plot,
    width = 12,
    height = 9
  )
}
```

```{R}
comparison <- do.call(rbind, lapply(
  names(spe_list), function(nm) {

    s <- spe_list[[nm]]

    data.frame(
      sample = nm,
      spots = ncol(s),

      mean_CD4T = mean(
        s$spotlight_CD4T,
        na.rm = TRUE
      ),

      mean_CD8T = mean(
        s$spotlight_CD8T,
        na.rm = TRUE
      ),

      median_CD4T = median(
        s$spotlight_CD4T,
        na.rm = TRUE
      ),

      median_CD8T = median(
        s$spotlight_CD8T,
        na.rm = TRUE
      )
    )
  }
))

print(comparison)

write.csv(
