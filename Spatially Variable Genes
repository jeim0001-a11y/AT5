```{r}
# Representative T-cell-associated marker genes
marker_genes <- c(
  "Tcf7",
  "Gzmb",
  "Il7r"
)

for (gene in marker_genes) {

  # Check gene is present exactly once in each sample
  gene_idx <- lapply(spe_list, function(s) {
    which(as.character(rowData(s)$Symbol) == gene)
  })

  if (!all(lengths(gene_idx) == 1)) {
    warning(paste("Skipping", gene, "- gene ID not unique"))
    next
  }

  # Determine a common expression scale
  max_expression <- max(unlist(
    lapply(names(spe_list), function(nm) {

      s <- spe_list[[nm]]
      i <- gene_idx[[nm]]

      as.numeric(logcounts(s)[i, ])
    })
  ), na.rm = TRUE)

  if (!is.finite(max_expression) ||
      max_expression <= 0) {
    next
  }

  plots <- lapply(names(spe_list), function(nm) {

    ggspavis::plotSpots(
      spe_list[[nm]],
      annotate = gene,
      feature_names = "Symbol",
      assay_name = "logcounts",
      point_size = 0.7
    ) +
      scale_colour_gradient(
        low = "grey95",
        high = "darkred",
        limits = c(0, max_expression)
      ) +
      ggtitle(nm)
  })

  combined <- patchwork::wrap_plots(
    plots,
    ncol = 2
  )

  print(combined)

  ggsave(
    file.path(
      output_dir,
      "figures",
      paste0(gene, "_four_samples.pdf")
    ),
    plot = combined,
    width = 12,
    height = 9
  )
}
